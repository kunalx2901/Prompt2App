# Copy this file to `.env` and replace the placeholder values.
DATABASE_URL="paste_your_prisma_accelerate_database_url_here"
# If you use Neon:
# - DIRECT_DATABASE_URL should be the direct, non-pooler Postgres host
# - do NOT use a hostname containing `-pooler`
DIRECT_DATABASE_URL="postgresql://username:password@direct-host:5432/database_name?sslmode=require"
JWT_SECRET_KEY="replace_with_a_long_random_secret"
JWT_ISSUER="prompt2app-local"
JWT_EXPIRES_IN="7d"
OPENROUTER_API_KEY="paste_your_openrouter_api_key_here"
